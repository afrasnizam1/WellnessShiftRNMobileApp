rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /** Signed-in user has a clinicians/{uid} profile (connection / care workflows). */
    function isClinicianAccount() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/clinicians/$(request.auth.uid));
    }

    function isClinicianForPatient(patientId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/patients/$(patientId)).data.linkedClinicianId == request.auth.uid;
    }

    /** Clinician is linked to patient via patients doc or clinicians/.../linkedPatients mirror. */
    function isLinkedClinicianOf(patientId) {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/patients/$(patientId)) &&
          get(/databases/$(database)/documents/patients/$(patientId)).data.linkedClinicianId == request.auth.uid
        ) ||
        exists(/databases/$(database)/documents/clinicians/$(request.auth.uid)/linkedPatients/$(patientId)) ||
        (
          exists(/databases/$(database)/documents/users/$(patientId)) &&
          get(/databases/$(database)/documents/users/$(patientId)).data.clinicianId == request.auth.uid
        )
      );
    }

    /** Signed-in user is a patient linked to this clinician (patients or legacy users field). */
    function isLinkedToClinician(clinicianId) {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/patients/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/patients/$(request.auth.uid)).data.linkedClinicianId == clinicianId
        ) || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicianId == clinicianId
        )
      );
    }

    /** Patient may add/remove only themselves on a clinician's users doc. */
    function isPatientLinkedPatientsPatch(clinicianUserId) {
      let before = resource.data.get('linkedPatients', []).toSet();
      let after = request.resource.data.get('linkedPatients', []).toSet();
      return isSignedIn() &&
        request.auth.uid != clinicianUserId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedPatients']) &&
        after.difference(before).union(before.difference(after)).hasOnly([request.auth.uid]);
    }

    // RN legacy user profiles — owner or linked clinician only.
    // Clinician email lookup goes through the sendClinicianConnectionRequest Cloud Function
    // (Admin SDK); clinicians can no longer read or query profiles they are not linked to.
    match /users/{userId} {
      allow read: if isOwner(userId) || isClinicianForPatient(userId) || isLinkedClinicianOf(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isPatientLinkedPatientsPatch(userId);
      allow delete: if isOwner(userId);

      match /carePlans/{planId} {
        allow read: if isOwner(userId) || isClinicianForPatient(userId);
        allow write: if isClinicianForPatient(userId) || isOwner(userId);
      }

      match /wellnessScores/{scoreId} {
        allow read: if isOwner(userId) || isClinicianForPatient(userId);
        allow write: if isOwner(userId);
      }

      match /dailyPlans/{planId} {
        allow read, write: if isOwner(userId);
      }

      match /dailyCheckIns/{checkInId} {
        allow read, write: if isOwner(userId);
      }

      match /activePrograms/{programId} {
        allow read, write: if isOwner(userId);
      }

      match /completedPrograms/{programId} {
        allow read, write: if isOwner(userId);
      }

      match /achievements/{achievementId} {
        allow read, write: if isOwner(userId);
      }

      match /stats/{statId} {
        allow read, write: if isOwner(userId);
      }

      match /habits/{habitId} {
        allow read, write: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      match /friends/{friendId} {
        allow read: if isOwner(userId) || isOwner(friendId);
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isOwner(userId) || isOwner(friendId);
      }

      match /accountabilityBoard/{entryId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /patients/{patientId} {
      allow read: if isOwner(patientId) || isClinicianForPatient(patientId) ||
        (isSignedIn() && resource.data.linkedClinicianId == request.auth.uid) ||
        isLinkedClinicianOf(patientId);
      allow create: if isOwner(patientId);
      allow update: if isOwner(patientId) || isClinicianForPatient(patientId);

      match /fitnessHubRecommendations/{recId} {
        allow read: if isOwner(patientId);
        allow write: if isClinicianForPatient(patientId);
      }

      match /pendingClinicianRequests/{requestId} {
        allow read: if isOwner(patientId) ||
          (isSignedIn() && resource.data.clinicianId == request.auth.uid);
        // Prefer Cloud Function creates; keep clinician create as fallback for offline/dev.
        allow create: if isClinicianAccount()
          && request.resource.data.clinicianId == request.auth.uid
          && request.resource.data.patientId == patientId
          && request.resource.data.status == 'pending';
        allow update, delete: if isOwner(patientId);
      }

      match /clinicalNotes/{noteId} {
        allow read: if isOwner(patientId) || isClinicianForPatient(patientId);
        allow write: if isClinicianForPatient(patientId);
      }
    }

    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /participants/{participantId} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(participantId);
        allow delete: if isOwner(participantId);
      }
    }

    // Clinician docs include work email, licence, phone, invite codes — not a public directory.
    match /clinicians/{clinicianId} {
      allow read: if isOwner(clinicianId) || isLinkedToClinician(clinicianId);
      allow create, update: if isOwner(clinicianId);

      match /linkedPatients/{patientId} {
        allow read: if isOwner(clinicianId) || isOwner(patientId);
        // The patient links themselves; a clinician may only mirror a patient who has
        // already linked to them (patients/{id}.linkedClinicianId). Either side may unlink.
        allow create, update: if isOwner(patientId) ||
          (isOwner(clinicianId) && isClinicianForPatient(patientId));
        allow delete: if isOwner(clinicianId) || isOwner(patientId);
      }

      match /outgoingRequests/{requestId} {
        allow read, write: if isOwner(clinicianId);
        allow update, delete: if isOwner(clinicianId) ||
          (isSignedIn() && resource.data.patientId == request.auth.uid);
      }
    }

    match /customCarePlans/{planId} {
      allow read: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.clinicianId == request.auth.uid
      );
      // Clinicians can only address a plan to a patient linked to them (or keep an
      // unaddressed draft/template). Patients can create plans for themselves.
      allow create: if isSignedIn() && (
        (
          request.resource.data.clinicianId == request.auth.uid && (
            !('patientId' in request.resource.data) ||
            request.resource.data.patientId == null ||
            isClinicianForPatient(request.resource.data.patientId)
          )
        ) ||
        request.resource.data.patientId == request.auth.uid
      );
      allow update: if isSignedIn() && resource.data.clinicianId == request.auth.uid && (
        !('patientId' in request.resource.data) ||
        request.resource.data.patientId == null ||
        request.resource.data.patientId == resource.data.get('patientId', null) ||
        isClinicianForPatient(request.resource.data.patientId)
      );
    }

    match /messageThreads/{threadId} {
      allow read: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.clinicianId == request.auth.uid
      );
      // Only the clinician may create or reopen/close a thread.
      allow create: if isSignedIn()
        && request.resource.data.clinicianId == request.auth.uid
        && request.resource.data.patientId is string
        && isLinkedClinicianOf(request.resource.data.patientId)
        && request.resource.data.status == 'open';
      allow update: if isSignedIn() && (
        // Clinician can change status / metadata / unread
        (
          resource.data.clinicianId == request.auth.uid
          && request.resource.data.clinicianId == resource.data.clinicianId
          && request.resource.data.patientId == resource.data.patientId
        )
        // Repair a thread that was created without clinician fields
        || (
          !('clinicianId' in resource.data)
          && request.resource.data.clinicianId == request.auth.uid
          && request.resource.data.patientId is string
          && request.resource.data.status == 'open'
          && isLinkedClinicianOf(request.resource.data.patientId)
        )
        // Patient may only update unread / last-message fields while thread is not closed
        || (
          resource.data.patientId == request.auth.uid
          && resource.data.status != 'closed'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['patientUnread', 'updatedAt', 'lastMessage', 'lastMessageAt', 'lastSenderId', 'clinicianUnread'])
        )
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/messageThreads/$(threadId)).data.patientId == request.auth.uid ||
          get(/databases/$(database)/documents/messageThreads/$(threadId)).data.clinicianId == request.auth.uid
        );
        // Messages only while conversation is open (legacy threads without status stay open).
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && (
            get(/databases/$(database)/documents/messageThreads/$(threadId)).data.status == 'open'
            || !('status' in get(/databases/$(database)/documents/messageThreads/$(threadId)).data)
          )
          && get(/databases/$(database)/documents/messageThreads/$(threadId)).data.status != 'closed'
          && (
            get(/databases/$(database)/documents/messageThreads/$(threadId)).data.patientId == request.auth.uid ||
            get(/databases/$(database)/documents/messageThreads/$(threadId)).data.clinicianId == request.auth.uid
          );
        allow update: if isSignedIn() &&
          (
            get(/databases/$(database)/documents/messageThreads/$(threadId)).data.patientId == request.auth.uid ||
            get(/databases/$(database)/documents/messageThreads/$(threadId)).data.clinicianId == request.auth.uid
          );
      }
    }

    // Lookup-only docs (clinicianId). Full clinician profiles are not readable here.
    // Codes are unique: update cannot steal another clinician's code.
    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.clinicianId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.clinicianId == request.auth.uid
        && request.resource.data.clinicianId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.clinicianId == request.auth.uid;
    }

    match /userProfiles/{userId} {
      allow read: if isOwner(userId) || isClinicianForPatient(userId);
      allow create, update: if isOwner(userId);
    }

    // The trial start is written once; it cannot be moved or extended from the client.
    match /userTrials/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if false;
    }

    match /fcmTokens/{userId} {
      allow read: if isOwner(userId) || isClinicianForPatient(userId);
      allow create, update, delete: if isOwner(userId);
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.patientId == request.auth.uid;
      // Only for yourself, or from a clinician to a patient linked to them.
      allow create: if isSignedIn() && request.resource.data.patientId is string && (
        request.resource.data.patientId == request.auth.uid ||
        isClinicianForPatient(request.resource.data.patientId)
      );
      allow update: if isSignedIn() && resource.data.patientId == request.auth.uid;
    }

    match /notificationQueue/{queueId} {
      allow create: if isSignedIn() && request.resource.data.patientId is string && (
        request.resource.data.patientId == request.auth.uid ||
        isClinicianForPatient(request.resource.data.patientId)
      );
      allow read, update: if false;
    }

    // Server-written subscription entitlements (Cloud Function only).
    match /entitlements/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }
  }
}
